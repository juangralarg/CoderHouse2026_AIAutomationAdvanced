{
  "name": "Manager_CoderHouse",
  "nodes": [
    {
      "parameters": { "options": {} },
      "id": "c3000003-0000-4000-8000-000000000001",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "webhookId": "c3000003-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "p1", "name": "consulta", "value": "={{ $json.chatInput }}", "type": "string" },
            { "id": "p2", "name": "identificador", "value": "={{ ($json.chatInput.match(/[A-Za-z]{2,3}[\\s-]?\\d{3,5}/) || [''])[0].replace(/[\\s-]/g, '') }}", "type": "string" },
            { "id": "p3", "name": "session_id", "value": "={{ $json.sessionId }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000003-0000-4000-8000-000000000002",
      "name": "Preparar Consulta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.consulta }}",
                    "rightValue": "(combustible|litro|kilomet|od[oó]metro|patente|m[oó]vil|carga)",
                    "operator": { "type": "string", "operation": "regex" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "COMBUSTIBLE"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{ $json.consulta }}",
                    "rightValue": "(\\bCL\\d+|nomenclatura|sitio|stu|UY-\\d)",
                    "operator": { "type": "string", "operation": "regex" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "NOMENCLATURA"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "FALLBACK_HUMANO" }
      },
      "id": "c3000003-0000-4000-8000-000000000003",
      "name": "Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "l1", "name": "consulta", "value": "={{ $json.consulta }}", "type": "string" },
            { "id": "l2", "name": "identificador", "value": "={{ $json.identificador }}", "type": "string" },
            { "id": "l3", "name": "session_id", "value": "={{ $json.session_id }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000003-0000-4000-8000-000000000004",
      "name": "Limpiar Payload Combustible",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, -140]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "l1", "name": "consulta", "value": "={{ $json.consulta }}", "type": "string" },
            { "id": "l2", "name": "identificador", "value": "={{ $json.identificador }}", "type": "string" },
            { "id": "l3", "name": "session_id", "value": "={{ $json.session_id }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000003-0000-4000-8000-000000000005",
      "name": "Limpiar Payload Nomenclatura",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 40]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "h1", "name": "status", "value": "escalated", "type": "string" },
            { "id": "h2", "name": "worker", "value": "HUMANO", "type": "string" },
            { "id": "h3", "name": "message", "value": "Transfiriendo tu caso a revisión humana", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000003-0000-4000-8000-000000000006",
      "name": "Escalamiento Humano",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 220]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "consulta": "={{ $json.consulta }}",
            "identificador": "={{ $json.identificador }}",
            "session_id": "={{ $json.session_id }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "c3000003-0000-4000-8000-000000000007",
      "name": "Worker Combustibles",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [900, -140],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "consulta": "={{ $json.consulta }}",
            "identificador": "={{ $json.identificador }}",
            "session_id": "={{ $json.session_id }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "c3000003-0000-4000-8000-000000000008",
      "name": "Worker Nomenclaturas",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [900, 40],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "status", "value": "={{ $json.status ?? 'error' }}", "type": "string" },
            { "id": "n2", "name": "worker", "value": "={{ $json.worker ?? 'DESCONOCIDO' }}", "type": "string" },
            { "id": "n3", "name": "data", "value": "={{ $json.data ?? [] }}", "type": "array" },
            { "id": "n4", "name": "message", "value": "={{ $json.message ?? ($json.error?.message || 'Sin respuesta del Worker') }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3000003-0000-4000-8000-000000000009",
      "name": "Respuesta Final",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1140, 40]
    }
  ],
  "connections": {
    "Chat Trigger": { "main": [[{ "node": "Preparar Consulta", "type": "main", "index": 0 }]] },
    "Preparar Consulta": { "main": [[{ "node": "Router", "type": "main", "index": 0 }]] },
    "Router": {
      "main": [
        [{ "node": "Limpiar Payload Combustible", "type": "main", "index": 0 }],
        [{ "node": "Limpiar Payload Nomenclatura", "type": "main", "index": 0 }],
        [{ "node": "Escalamiento Humano", "type": "main", "index": 0 }]
      ]
    },
    "Limpiar Payload Combustible": { "main": [[{ "node": "Worker Combustibles", "type": "main", "index": 0 }]] },
    "Limpiar Payload Nomenclatura": { "main": [[{ "node": "Worker Nomenclaturas", "type": "main", "index": 0 }]] },
    "Worker Combustibles": { "main": [[{ "node": "Respuesta Final", "type": "main", "index": 0 }]] },
    "Worker Nomenclaturas": { "main": [[{ "node": "Respuesta Final", "type": "main", "index": 0 }]] },
    "Escalamiento Humano": { "main": [[{ "node": "Respuesta Final", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "executionTimeout": 120 }
}